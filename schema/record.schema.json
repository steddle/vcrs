{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://vcrs.org/schema/0.1.0-beta.5/record.schema.json",
    "title": "VCRS record",
    "description": "One person's entry in a facts export: the facts that set its grade (VCRS 0.1.0-beta.5, section 4), without the name, contact details and documents behind them. For whoever can link its identifier to the source records, the representative first, it is personal data.",
    "type": "object",
    "required": [
        "id",
        "party",
        "status",
        "joined_on",
        "flow",
        "terms",
        "identity",
        "membership",
        "duplicate_of"
    ],
    "additionalProperties": false,
    "properties": {
        "id": {
            "description": "The record's identifier in the register. Pseudonymous: never a name, an email address or a national number.",
            "$ref": "#/$defs/id"
        },
        "party": {
            "enum": [
                "natural",
                "legal"
            ]
        },
        "status": {
            "enum": [
                "active",
                "withdrawn",
                "opted_out",
                "excluded"
            ]
        },
        "status_on": {
            "description": "The day the status last changed, required for every status but active. A change dated after the reference date leaves the record active at it (section 4.1).",
            "$ref": "#/$defs/date"
        },
        "status_reason": {
            "description": "Why a record is excluded, where its status is excluded: late, joined after the deadline; refused, the court or the claimant refused the joining; defective, the joining was ineffective or left uncorrected; unpaid, a fee the law allows was not paid; ended, membership ended later, by law or by a settlement.",
            "enum": [
                "late",
                "refused",
                "defective",
                "unpaid",
                "ended"
            ]
        },
        "joined_on": {
            "$ref": "#/$defs/date"
        },
        "flow": {
            "description": "The flow version the person joined through.",
            "$ref": "#/$defs/id"
        },
        "confirmed": {
            "description": "Where the person joined through a flow version that does not inform: the version they later confirmed through, and the day (section 5.1). The joining flow stays as it was.",
            "type": "object",
            "required": [
                "flow",
                "on"
            ],
            "additionalProperties": false,
            "properties": {
                "flow": {
                    "$ref": "#/$defs/id"
                },
                "on": {
                    "$ref": "#/$defs/date"
                }
            }
        },
        "terms": {
            "description": "The terms version the person accepted.",
            "$ref": "#/$defs/id"
        },
        "identity": {
            "type": "object",
            "required": [
                "name",
                "contact_confirmed",
                "verified"
            ],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "description": "A name is held.",
                    "type": "boolean"
                },
                "birth_date": {
                    "description": "A date of birth is held. Natural persons.",
                    "type": "boolean"
                },
                "registration_number": {
                    "description": "A business or associations register number is held. Legal persons.",
                    "type": "boolean"
                },
                "contact_confirmed": {
                    "description": "The person confirmed a contact channel, for example by a link sent to it.",
                    "type": "boolean"
                },
                "verified": {
                    "description": "How identity was verified, or null where it was not (section 4.4).",
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "object",
                            "required": [
                                "scheme",
                                "assurance",
                                "on"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "scheme": {
                                    "description": "eidas for a notified eIDAS means or the EU Digital Identity Wallet; otherwise a scheme an annex names, such as idin.",
                                    "type": "string",
                                    "pattern": "^[a-z0-9_-]{2,32}$"
                                },
                                "assurance": {
                                    "enum": [
                                        "low",
                                        "substantial",
                                        "high"
                                    ]
                                },
                                "on": {
                                    "$ref": "#/$defs/date"
                                }
                            }
                        }
                    ]
                },
                "register_check": {
                    "description": "For a legal person: the business register its registration was checked against, and the day (section 4.4).",
                    "type": "object",
                    "required": [
                        "register",
                        "on"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "register": {
                            "type": "string",
                            "minLength": 1
                        },
                        "on": {
                            "$ref": "#/$defs/date"
                        }
                    }
                },
                "authority": {
                    "description": "For a legal person: the authority of the person acting for it, as checked (section 4.4). role: what the person is, such as a director or an attorney. basis: what gives the authority, such as the register's entry or a power of attorney. checked_against: the source it was checked against.",
                    "type": "object",
                    "required": [
                        "role",
                        "basis",
                        "checked_against",
                        "on"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "role": {
                            "type": "string",
                            "minLength": 1
                        },
                        "basis": {
                            "type": "string",
                            "minLength": 1
                        },
                        "checked_against": {
                            "type": "string",
                            "minLength": 1
                        },
                        "on": {
                            "$ref": "#/$defs/date"
                        }
                    }
                }
            }
        },
        "membership": {
            "type": "object",
            "required": [
                "basis",
                "in_class",
                "evidence",
                "checked_against"
            ],
            "additionalProperties": false,
            "properties": {
                "basis": {
                    "description": "declared: the person's own word. supplied: evidence the person provided. checked: a source outside the person (section 4.3).",
                    "enum": [
                        "declared",
                        "supplied",
                        "checked"
                    ]
                },
                "in_class": {
                    "description": "Whether the facts held place the person inside the class definition: true, false, or null where they don't decide it.",
                    "type": [
                        "boolean",
                        "null"
                    ]
                },
                "evidence": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "type",
                            "digest"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "type": {
                                "type": "string",
                                "minLength": 1
                            },
                            "digest": {
                                "$ref": "#/$defs/digest"
                            }
                        }
                    }
                },
                "checked_against": {
                    "description": "The source outside the person that membership was checked against, where basis is checked.",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "residence": {
            "description": "The person's country of habitual residence, the date it was established for, and its source (section 4.6). Where the export states a residence_on, the date is that one.",
            "type": "object",
            "required": [
                "country",
                "on"
            ],
            "additionalProperties": false,
            "properties": {
                "country": {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$"
                },
                "on": {
                    "$ref": "#/$defs/date"
                },
                "source": {
                    "description": "Where the residence comes from: the person's declaration, an identity document, a register. A record whose opt-in turns on its residence holds it.",
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "opt_in": {
            "description": "The person's express statement that they want to be represented in this action, where the annex requires one (section 4.6): when they made it, through which channel, and the action it names.",
            "type": "object",
            "required": [
                "on",
                "channel",
                "action"
            ],
            "additionalProperties": false,
            "properties": {
                "on": {
                    "$ref": "#/$defs/date"
                },
                "channel": {
                    "description": "Where the opt-in went. Where the term or the annex names a channel, it holds that value as written (registry under Annex NL); any other value does not count.",
                    "type": "string",
                    "minLength": 1
                },
                "action": {
                    "description": "The action the opt-in names, as the court refers to it. Where the export states the court's reference, an opt-in that names another does not count.",
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "parallel_declared": {
            "description": "The person declared they are not represented in another action, and claim nowhere else, on the same claim against the same defendant (section 4.6).",
            "type": "boolean"
        },
        "dedupe_key": {
            "description": "A salted digest of the normalised identifying fields (section 4.5).",
            "type": "string",
            "pattern": "^[0-9a-f]{16,128}$"
        },
        "duplicate_of": {
            "oneOf": [
                {
                    "$ref": "#/$defs/id"
                },
                {
                    "type": "null"
                }
            ]
        },
        "facets": {
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        },
        "subgroup": {
            "type": "string",
            "minLength": 1
        },
        "parts": {
            "description": "Where the claim falls under two laws, the parts the record belongs to (section 4.6).",
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
        },
        "grade": {
            "description": "The grade the operator states. A validator recomputes it.",
            "enum": [
                "A",
                "B",
                "C",
                "D"
            ]
        },
        "digest": {
            "description": "SHA-256 of the record's canonical form without this member (section 11.3).",
            "$ref": "#/$defs/digest"
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "status": {
                        "const": "active"
                    }
                }
            },
            "else": {
                "required": [
                    "status_on"
                ]
            }
        },
        {
            "if": {
                "required": [
                    "status_reason"
                ]
            },
            "then": {
                "properties": {
                    "status": {
                        "const": "excluded"
                    }
                }
            }
        }
    ],
    "$defs": {
        "date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        }
    }
}
