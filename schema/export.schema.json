{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://vcrs.steddle.com/schema/0.1.0-beta.2/export.schema.json",
    "title": "VCRS facts export",
    "description": "A claimant register in the open format of VCRS 0.1.0-beta.2, section 11.1: the facts that set each record's grade, without the personal data behind them.",
    "type": "object",
    "required": [
        "vcrs",
        "annex",
        "representative",
        "action",
        "operator",
        "class",
        "reference_date",
        "opt_in_opened_on",
        "opt_in_closed_on",
        "opt_in_channel",
        "opt_in_residents",
        "denominator",
        "flows",
        "terms",
        "records"
    ],
    "additionalProperties": false,
    "properties": {
        "vcrs": {
            "const": "0.1.0-beta.2"
        },
        "annex": {
            "description": "The jurisdiction annex applied, by ISO 3166-1 alpha-2 code in lowercase.",
            "type": "string",
            "pattern": "^[a-z]{2}$"
        },
        "representative": {
            "type": "object",
            "required": [
                "name"
            ],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "registration": {
                    "description": "Its number in the business or associations register.",
                    "type": "string"
                }
            }
        },
        "action": {
            "type": "object",
            "required": [
                "title",
                "defendants",
                "directive"
            ],
            "additionalProperties": false,
            "properties": {
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "defendants": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "minItems": 1
                },
                "court_reference": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "directive": {
                    "description": "Whether the action is brought under the forum's transposition of Directive (EU) 2020/1828. An annex may bind people abroad only on an opt-in in such an action alone (section 4.6).",
                    "type": "boolean"
                }
            }
        },
        "operator": {
            "type": "string",
            "minLength": 1
        },
        "class": {
            "type": "object",
            "required": [
                "definition",
                "version",
                "approved_on"
            ],
            "additionalProperties": false,
            "properties": {
                "definition": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                },
                "approved_on": {
                    "$ref": "#/$defs/date"
                }
            }
        },
        "reference_date": {
            "$ref": "#/$defs/date"
        },
        "opt_in_opened_on": {
            "description": "The first day of the window the court set for the people who must opt in (section 4.6); where it sets more than one term, the first day of the first. Null where no window is set, or where the annex has no window.",
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "$ref": "#/$defs/date"
                }
            ]
        },
        "opt_in_closed_on": {
            "description": "The last day of the window the court set for the people who must opt in (section 4.6); where it sets more than one term, the last day of the last, once that term is set. Null until then, where the annex has no window, or where the court applied opt-out to people abroad.",
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "$ref": "#/$defs/date"
                }
            ]
        },
        "opt_in_channel": {
            "description": "The channel the court set for opt-ins, written as the records write it in opt_in.channel (section 4.6). Null where the annex's own channel applies, as it always does where the annex has no window.",
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "type": "string",
                    "minLength": 1
                }
            ]
        },
        "opt_in_residents": {
            "description": "Whether residents of the forum opt in in this action, where the annex leaves it to the court or an approved agreement (section 4.6). Null where the annex decides.",
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "type": "boolean"
                }
            ]
        },
        "denominator": {
            "description": "The size of the class: a range, or a figure as low equal to high (section 6.1).",
            "type": "object",
            "required": [
                "low",
                "high",
                "source",
                "method",
                "as_of"
            ],
            "additionalProperties": false,
            "properties": {
                "low": {
                    "type": "integer",
                    "minimum": 1
                },
                "high": {
                    "type": "integer",
                    "minimum": 1
                },
                "source": {
                    "type": "string",
                    "minLength": 1
                },
                "method": {
                    "type": "string",
                    "minLength": 1
                },
                "as_of": {
                    "$ref": "#/$defs/date"
                }
            }
        },
        "claims": {
            "description": "The size of the represented claims, where damages are claimed (section 6.5): a range in whole units of the currency, with its method.",
            "type": "object",
            "required": [
                "low",
                "high",
                "currency",
                "method"
            ],
            "additionalProperties": false,
            "properties": {
                "low": {
                    "type": "integer",
                    "minimum": 0
                },
                "high": {
                    "type": "integer",
                    "minimum": 0
                },
                "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                },
                "method": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "facets": {
            "description": "The class's own facets (section 6.3): per facet, its values, each with the class's share where the denominator's source gives it, else null.",
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                }
            }
        },
        "subgroups": {
            "description": "The class's real subgroups (section 6.4). Empty when it has none.",
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "uniqueItems": true
        },
        "organisations": {
            "description": "Support from other organisations, kept apart from the records (section 6.6).",
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "on",
                    "form"
                ],
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1
                    },
                    "on": {
                        "$ref": "#/$defs/date"
                    },
                    "form": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "anchor": {
            "description": "How the snapshot root of this reference date is anchored in time (section 5.4).",
            "type": "object",
            "required": [
                "method",
                "reference",
                "on",
                "root"
            ],
            "additionalProperties": false,
            "properties": {
                "method": {
                    "enum": [
                        "notary",
                        "qualified_timestamp",
                        "opentimestamps"
                    ]
                },
                "reference": {
                    "type": "string",
                    "minLength": 1
                },
                "on": {
                    "$ref": "#/$defs/date"
                },
                "root": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "previous_snapshots": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "reference_date",
                    "root"
                ],
                "additionalProperties": false,
                "properties": {
                    "reference_date": {
                        "$ref": "#/$defs/date"
                    },
                    "root": {
                        "$ref": "#/$defs/digest"
                    }
                }
            }
        },
        "flows": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/flow"
            }
        },
        "terms": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "id"
                ],
                "additionalProperties": false,
                "properties": {
                    "id": {
                        "$ref": "#/$defs/id"
                    },
                    "digest": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/digest"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    }
                }
            }
        },
        "records": {
            "type": "array",
            "items": {
                "$ref": "record.schema.json"
            }
        }
    },
    "$defs": {
        "date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        },
        "flow": {
            "description": "One published version of the sign-up flow (section 5.1).",
            "type": "object",
            "required": [
                "id",
                "live_from",
                "live_to",
                "locales",
                "states",
                "capture"
            ],
            "additionalProperties": false,
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "live_from": {
                    "$ref": "#/$defs/date"
                },
                "live_to": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/date"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "locales": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 2
                    },
                    "minItems": 1
                },
                "states": {
                    "description": "What the version states before a person joins.",
                    "type": "object",
                    "required": [
                        "representative",
                        "defendant",
                        "claim",
                        "period"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "representative": {
                            "type": "boolean"
                        },
                        "defendant": {
                            "type": "boolean"
                        },
                        "claim": {
                            "type": "boolean"
                        },
                        "period": {
                            "type": "boolean"
                        }
                    }
                },
                "capture": {
                    "description": "The capture of every screen of this version in every locale, or null where none was made.",
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "object",
                            "required": [
                                "digest",
                                "witnessed"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "digest": {
                                    "oneOf": [
                                        {
                                            "$ref": "#/$defs/digest"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ]
                                },
                                "witnessed": {
                                    "oneOf": [
                                        {
                                            "type": "null"
                                        },
                                        {
                                            "type": "object",
                                            "required": [
                                                "by",
                                                "on",
                                                "reference"
                                            ],
                                            "additionalProperties": false,
                                            "properties": {
                                                "by": {
                                                    "enum": [
                                                        "bailiff",
                                                        "notary"
                                                    ]
                                                },
                                                "on": {
                                                    "$ref": "#/$defs/date"
                                                },
                                                "reference": {
                                                    "type": "string",
                                                    "minLength": 1
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        }
    }
}
