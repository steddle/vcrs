{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://vcrs.org/schema/0.1.0-beta.5/export.schema.json",
    "title": "VCRS facts export",
    "description": "A claimant register in the open format of VCRS 0.1.0-beta.5, section 11.1: the facts that set each record's grade, without the names, contact details and documents behind them. Its records keep their pseudonymous identifiers, so for whoever can link them to the source records, the representative first, the export is personal data.",
    "type": "object",
    "required": [
        "vcrs",
        "annex",
        "representative",
        "action",
        "operator",
        "class",
        "reference_date",
        "opt_in_terms",
        "opt_in_residents",
        "denominator",
        "flows",
        "terms",
        "records"
    ],
    "additionalProperties": false,
    "properties": {
        "vcrs": {
            "const": "0.1.0-beta.5"
        },
        "annex": {
            "description": "The jurisdiction annex applied, by ISO 3166-1 alpha-2 code in lowercase.",
            "type": "string",
            "pattern": "^[a-z]{2}$"
        },
        "representative": {
            "type": "object",
            "required": [
                "name"
            ],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "registration": {
                    "description": "Its number in the business or associations register.",
                    "type": "string"
                }
            }
        },
        "action": {
            "type": "object",
            "required": [
                "title",
                "defendants",
                "directive"
            ],
            "additionalProperties": false,
            "properties": {
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "defendants": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "minItems": 1
                },
                "court_reference": {
                    "description": "The court's reference for the action, once it has one. An opt-in that names another action leaves the grade as it is and withholds every level (sections 4.6 and 11.6, finding opt_in_names_other_action).",
                    "type": "string",
                    "minLength": 1
                },
                "directive": {
                    "description": "Whether the action is brought under the forum's transposition of Directive (EU) 2020/1828. An annex may bind people abroad on an opt-in only in such an action (section 4.6).",
                    "type": "boolean"
                }
            }
        },
        "operator": {
            "type": "string",
            "minLength": 1
        },
        "class": {
            "type": "object",
            "required": [
                "definition",
                "version",
                "approved_on"
            ],
            "additionalProperties": false,
            "properties": {
                "definition": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                },
                "approved_on": {
                    "$ref": "#/$defs/date"
                }
            }
        },
        "reference_date": {
            "$ref": "#/$defs/date"
        },
        "opt_in_terms": {
            "description": "The terms set for the people who must opt in (section 4.6): those the court sets after it appoints the representative, or the deadline the law sets where the annex has no window. Empty where none is set. A term holds its first day, its last day once set, the channel the court set for it, and the subgroups it applies to where it applies to some alone.",
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "opened_on",
                    "closed_on",
                    "channel"
                ],
                "additionalProperties": false,
                "properties": {
                    "opened_on": {
                        "$ref": "#/$defs/date"
                    },
                    "closed_on": {
                        "oneOf": [
                            {
                                "type": "null"
                            },
                            {
                                "$ref": "#/$defs/date"
                            }
                        ]
                    },
                    "channel": {
                        "description": "The channel the court set, written as the records write it in opt_in.channel. Null where the annex's own channel applies.",
                        "oneOf": [
                            {
                                "type": "null"
                            },
                            {
                                "type": "string",
                                "minLength": 1
                            }
                        ]
                    },
                    "subgroups": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "minLength": 1
                        },
                        "minItems": 1,
                        "uniqueItems": true
                    }
                }
            }
        },
        "opt_in_residents": {
            "description": "Whether, in this action, residents of the forum opt in, where the annex leaves it to the court or an approved agreement (section 4.6): for the whole action, or per subgroup where an agreement sets it per category. Null where the annex decides.",
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "type": "boolean"
                },
                {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                        "type": "boolean"
                    }
                }
            ]
        },
        "residence_on": {
            "description": "The date the court fixed for the residence the opt-in turns on, where it fixed one (section 4.6). Every record's residence is then established for that date.",
            "$ref": "#/$defs/date"
        },
        "denominator": {
            "description": "The size of the class: a range, or a figure as low equal to high (section 6.1).",
            "type": "object",
            "required": [
                "low",
                "high",
                "source",
                "method",
                "as_of"
            ],
            "additionalProperties": false,
            "properties": {
                "low": {
                    "type": "integer",
                    "minimum": 1
                },
                "high": {
                    "type": "integer",
                    "minimum": 1
                },
                "source": {
                    "type": "string",
                    "minLength": 1
                },
                "method": {
                    "type": "string",
                    "minLength": 1
                },
                "as_of": {
                    "$ref": "#/$defs/date"
                }
            }
        },
        "claims": {
            "description": "The size of the represented claims, where damages are claimed (section 6.5): a range in whole units of the currency, with its method.",
            "type": "object",
            "required": [
                "low",
                "high",
                "currency",
                "method"
            ],
            "additionalProperties": false,
            "properties": {
                "low": {
                    "type": "integer",
                    "minimum": 0
                },
                "high": {
                    "type": "integer",
                    "minimum": 0
                },
                "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                },
                "method": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "facets": {
            "description": "The class's own facets (section 6.3): per facet, its values, each with the class's share where the denominator's source gives it, else null.",
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                }
            }
        },
        "subgroups": {
            "description": "The class's real subgroups (section 6.4). Empty when it has none.",
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "uniqueItems": true
        },
        "parts": {
            "description": "Where a claim falls under two laws, as a transitional rule may split it, the parts' names, as the annex gives them (section 4.6). Absent where one law governs the whole claim.",
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "minItems": 2,
            "uniqueItems": true
        },
        "organisations": {
            "description": "Support from other organisations, kept apart from the records (section 6.6).",
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "on",
                    "form"
                ],
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1
                    },
                    "on": {
                        "$ref": "#/$defs/date"
                    },
                    "form": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "anchor": {
            "description": "How this reference date's manifest is anchored in time (section 5.4): the method, its reference and day, the snapshot root, and the manifest's digest, which is what was anchored.",
            "type": "object",
            "required": [
                "method",
                "reference",
                "on",
                "root",
                "manifest"
            ],
            "additionalProperties": false,
            "properties": {
                "method": {
                    "enum": [
                        "notary",
                        "qualified_timestamp",
                        "opentimestamps"
                    ]
                },
                "reference": {
                    "type": "string",
                    "minLength": 1
                },
                "on": {
                    "$ref": "#/$defs/date"
                },
                "root": {
                    "$ref": "#/$defs/digest"
                },
                "manifest": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "previous_snapshots": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "reference_date",
                    "root"
                ],
                "additionalProperties": false,
                "properties": {
                    "reference_date": {
                        "$ref": "#/$defs/date"
                    },
                    "root": {
                        "$ref": "#/$defs/digest"
                    },
                    "manifest": {
                        "$ref": "#/$defs/digest"
                    }
                }
            }
        },
        "flows": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/flow"
            }
        },
        "terms": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "id"
                ],
                "additionalProperties": false,
                "properties": {
                    "id": {
                        "$ref": "#/$defs/id"
                    },
                    "digest": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/digest"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    }
                }
            }
        },
        "records": {
            "type": "array",
            "items": {
                "$ref": "record.schema.json"
            }
        }
    },
    "$defs": {
        "date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        },
        "flow": {
            "description": "One published version of the sign-up flow (section 5.1).",
            "type": "object",
            "required": [
                "id",
                "live_from",
                "live_to",
                "locales",
                "states",
                "capture"
            ],
            "additionalProperties": false,
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "live_from": {
                    "$ref": "#/$defs/date"
                },
                "live_to": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/date"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "locales": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 2
                    },
                    "minItems": 1
                },
                "states": {
                    "description": "What the version states before a person joins.",
                    "type": "object",
                    "required": [
                        "representative",
                        "defendant",
                        "claim",
                        "period"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "representative": {
                            "type": "boolean"
                        },
                        "defendant": {
                            "type": "boolean"
                        },
                        "claim": {
                            "type": "boolean"
                        },
                        "period": {
                            "type": "boolean"
                        }
                    }
                },
                "capture": {
                    "description": "The capture of every screen of this version in every locale, or null where none was made.",
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "object",
                            "required": [
                                "digest",
                                "witnessed"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "digest": {
                                    "oneOf": [
                                        {
                                            "$ref": "#/$defs/digest"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ]
                                },
                                "witnessed": {
                                    "oneOf": [
                                        {
                                            "type": "null"
                                        },
                                        {
                                            "type": "object",
                                            "required": [
                                                "by",
                                                "on",
                                                "reference"
                                            ],
                                            "additionalProperties": false,
                                            "properties": {
                                                "by": {
                                                    "enum": [
                                                        "bailiff",
                                                        "notary"
                                                    ]
                                                },
                                                "on": {
                                                    "$ref": "#/$defs/date"
                                                },
                                                "reference": {
                                                    "type": "string",
                                                    "minLength": 1
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        }
    }
}
